    </div>
    """, unsafe_allow_html=True)

    with st.sidebar:
        st.markdown(f"### Hello, {st.session_state.delivery_name}")
        if st.button("🔄 Refresh", use_container_width=True):
            st.rerun()
        if st.button("🚪 Logout", use_container_width=True):
            st.session_state.delivery_logged_in = False
            st.session_state.role = None
            st.rerun()

    tab1, tab2, tab3, tab4 = st.tabs([
        "🟡 Trade-in Pickups",
        "✅ Verified (Pay Customer)",
        "🛒 Refurbished Deliveries",
        "👥 All Customers"
    ])

    # Tab 1: Trade-in Pickups
    with tab1:
        pending = [o for o in st.session_state.quote_history if o["Status"] == "Pending Pickup"]
        if not pending:
            st.info("No pending trade-in pickups.")
        for order in pending:
            st.markdown(f"""
            <div class="order-card">
                <b>{order['Quote ID']}</b> • {order['Timestamp']}<br>
                👤 <b>{order['Customer Name']}</b> &nbsp; 📞 <b>{order['Phone']}</b><br>
                📍 {order['Address']}<br>
                📦 {order['Devices']}<br>
                💰 {order['Total Offer']}
            </div>
            """, unsafe_allow_html=True)
            new_cond = st.selectbox("Actual Condition", list(CONDITION_MULTIPLIERS.keys()), key=f"cond_{order['Quote ID']}")
            notes = st.text_area("Notes", key=f"notes_{order['Quote ID']}", height=60)
            if st.button("✅ Physical Verification Done", key=f"ver_{order['Quote ID']}", type="primary"):
                for o in st.session_state.quote_history:
                    if o["Quote ID"] == order["Quote ID"]:
                        o["Status"] = "Physical Verified – Ready for Payment"
                        o["Physical Verified"] = True
                        o["Verified By"] = st.session_state.delivery_name
                        break
                st.success("Marked as Verified!")
                st.rerun()
            st.markdown("---")

    # Tab 2: Pay Customer
    with tab2:
        verified = [o for o in st.session_state.quote_history if o.get("Physical Verified") and not o.get("Payment Done")]
        if not verified:
            st.info("No payments pending.")
        for order in verified:
            st.markdown(f"""
            <div class="order-card">
                <b>{order['Quote ID']}</b><br>
                👤 {order['Customer Name']} • 📞 {order['Phone']}<br>
                💰 Pay: <b>{order['Total Offer']}</b>
            </div>
            """, unsafe_allow_html=True)
            if st.button(f"💵 Payment Completed – {order['Quote ID']}", key=f"pay_{order['Quote ID']}"):
                for o in st.session_state.quote_history:
                    if o["Quote ID"] == order["Quote ID"]:
                        o["Status"] = "Payment Completed"
                        o["Payment Done"] = True
                        break
                st.success("Payment done!")
                st.rerun()

    # Tab 3: Refurbished Deliveries (NEW)
    with tab3:
        st.markdown("### 🛒 Refurbished Purchase Orders")
        st.caption("These are devices customers bought from the Refurbished Store. Deliver them.")
        pending_refurb = [o for o in st.session_state.refurbished_orders if o["Status"] == "Pending Delivery"]
        if not pending_refurb:
            st.info("No refurbished deliveries pending.")
        for order in pending_refurb:
            st.markdown(f"""
            <div class="order-card">
                <b>{order['Order ID']}</b> • {order['Timestamp']}<br>
                👤 <b>{order['Customer Name']}</b> &nbsp; 📞 {order.get('Phone', 'N/A')}<br>
                📦 {order['Item']} × {order['Qty']}<br>
                💰 ₹{order['Total']:,}<br>
                Status: {order['Status']}
            </div>
            """, unsafe_allow_html=True)
            if st.button(f"✅ Mark as Delivered – {order['Order ID']}", key=f"del_{order['Order ID']}", type="primary"):
                for o in st.session_state.refurbished_orders:
                    if o["Order ID"] == order["Order ID"]:
                        o["Status"] = "Delivered"
                        o["Assigned To"] = st.session_state.delivery_name
                        break
                st.success("Marked as Delivered!")
                st.rerun()
            st.markdown("---")

    # Tab 4: Customers
    with tab4:
        st.markdown("### Registered Customers")
        if not st.session_state.quote_history and not st.session_state.refurbished_orders:
            st.info("No customers yet.")
        else:
            customers = {}
            for o in st.session_state.quote_history + st.session_state.refurbished_orders:
                phone = o.get("Phone", "N/A")
                if phone not in customers:
                    customers[phone] = {"Name": o.get("Customer Name"), "Phone": phone, "Email": o.get("Email"), "Orders": 0}
                customers[phone]["Orders"] += 1
            st.dataframe(pd.DataFrame(customers.values()), use_container_width=True, hide_index=True)
