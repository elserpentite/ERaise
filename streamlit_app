    # ─────────────── REFURBISHED STORE ───────────────
    if st.session_state.customer_view == "refurbished":
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("### 🛒 Refurbished Store")
        st.caption("Browse by category (folder view) and buy quality refurbished devices")

        # Folder-style category navigation
        categories = sorted(list(set(item["category"] for item in st.session_state.refurbished_inventory)))
        selected_folder = st.selectbox("📁 Select Category Folder", ["All"] + categories)

        # Filter items
        if selected_folder == "All":
            items = st.session_state.refurbished_inventory
        else:
            items = [i for i in st.session_state.refurbished_inventory if i["category"] == selected_folder]

        if not items:
            st.info("No items available in this folder.")
        else:
            for item in items:
                if item["qty"] <= 0:
                    continue
                col1, col2, col3 = st.columns([3, 2, 1.5])
                with col1:
                    st.markdown(f"""
                    <div class="refurb-card">
                        <b>{item['model']}</b><br>
                        <small>{item['category']} • {item['storage']} • {item['condition']}</small><br>
                        <span style="color:#047857; font-weight:800; font-size:1.2rem;">₹{item['price']:,}</span>
                        &nbsp; <small>({item['qty']} left)</small>
                    </div>
                    """, unsafe_allow_html=True)
                with col2:
                    buy_qty = st.number_input(f"Qty", 1, item["qty"], 1, key=f"bq_{item['id']}")
                with col3:
                    if st.button("Buy Now", key=f"buy_{item['id']}", type="primary"):
                        # Create refurbished order
                        order_id = f"RF-{random.randint(10000,99999)}"
                        order = {
                            "Order ID": order_id,
                            "Timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
                            "Customer Name": st.session_state.user_name,
                            "Email": st.session_state.user_email,
                            "Phone": st.session_state.get("cust_phone", "Not provided"),
                            "Item": f"{item['model']} ({item['storage']})",
                            "Category": item["category"],
                            "Condition": item["condition"],
                            "Qty": buy_qty,
                            "Total": item["price"] * buy_qty,
                            "Status": "Pending Delivery",
                            "Assigned To": ""
                        }
                        st.session_state.refurbished_orders.append(order)

                        # Reduce stock
                        for inv in st.session_state.refurbished_inventory:
                            if inv["id"] == item["id"]:
                                inv["qty"] -= buy_qty
                                break

                        st.success(f"✅ Order **{order_id}** placed! Total: ₹{item['price']*buy_qty:,}")
                        st.balloons()
                        st.rerun()

        st.markdown('</div>', unsafe_allow_html=True)

        # Customer's refurbished purchase history
        my_refurb = [o for o in st.session_state.refurbished_orders if o["Email"] == st.session_state.user_email]
        if my_refurb:
            st.markdown('<div class="section-card">', unsafe_allow_html=True)
            st.markdown("### 📦 Your Refurbished Purchases")
            for o in my_refurb:
                st.markdown(f"**{o['Order ID']}** • {o['Item']} × {o['Qty']} • ₹{o['Total']:,} • Status: **{o['Status']}**")
            st.markdown('</div>', unsafe_allow_html=True)

    # ─────────────── TRADE-IN FLOW ───────────────
    else:
        # Sidebar categories for trade-in
        with st.sidebar:
            st.markdown("### 📱 Trade-in Categories")
            for cat in DEVICE_CATALOG.keys():
                if st.button(cat, key=f"c_{cat}", use_container_width=True,
