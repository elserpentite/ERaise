# STEP 2: ADD DEVICE
# ────────────────────────────────────────────────
elif st.session_state.current_step == 2:
    st.markdown('<div class="section-card">', unsafe_allow_html=True)
    st.markdown(f"### 2. Add Device to Cart  \n**Selected Category:** `{st.session_state.selected_category}`")

    # Use the category selected from sidebar
    category = st.session_state.selected_category

    # Allow changing category also from here (optional)
    category = st.selectbox(
        "Category",
        list(DEVICE_CATALOG.keys()),
        index=list(DEVICE_CATALOG.keys()).index(category),
        key="add_cat"
    )
    # Keep sidebar in sync
    st.session_state.selected_category = category

    model = st.selectbox("Model", sorted(DEVICE_CATALOG[category].keys()), key="add_model")

    s1, s2, s3 = st.columns(3)
    with s1:
        storage = st.selectbox("Storage / RAM", list(STORAGE_PREMIUMS.keys()), key="add_storage")
    with s2:
        carrier = st.selectbox("Network Status", list(CARRIER_MODIFIERS.keys()), key="add_carrier")
    with s3:
        condition = st.selectbox("Condition", list(CONDITION_MULTIPLIERS.keys()), key="add_condition")

    imei = st.text_input("IMEI / Serial Number *", placeholder="15-digit IMEI or Serial", key="add_imei")
    qty = st.number_input("Quantity", min_value=1, max_value=10, value=1, key="add_qty")

    uploaded_images = st.file_uploader("Upload photos (optional)", type=["jpg", "jpeg", "png"],
                                       accept_multiple_files=True, key="add_imgs")

    # Live price calculation
    base = DEVICE_CATALOG[category][model]
    storage_bonus = STORAGE_PREMIUMS[storage]
    carrier_bonus = CARRIER_MODIFIERS[carrier]
    multiplier = CONDITION_MULTIPLIERS[condition]
    raw = ((base + storage_bonus) * multiplier) + carrier_bonus
    unit_price = max(8.0, raw) * curr_rate
    line_total = unit_price * qty

    st.info(f"**Live estimate:** {curr_sym}{unit_price:,.0f} × {qty} = **{curr_sym}{line_total:,.0f}**")

    col_btn1, col_btn2 = st.columns(2)
    with col_btn1:
        if st.button("➕ Add to Cart", type="secondary", use_container_width=True):
            if not imei.strip():
                st.warning("Please enter IMEI / Serial number")
            else:
                st.session_state.cart.append({
                    "category": category,
                    "model": model,
                    "storage": storage,
                    "carrier": carrier,
                    "condition": condition,
                    "imei": imei.strip(),
                    "qty": qty,
                    "unit_price": unit_price,
                    "line_total": line_total
                })
                st.success(f"Added **{model}** × {qty}")
                st.rerun()
    with col_btn2:
        if st.button("Next → Review Cart", type="primary", use_container_width=True):
            st.session_state.current_step = 3
            st.rerun()

    st.markdown('</div>', unsafe_allow_html=True)

