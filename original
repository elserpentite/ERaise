elif st.session_state.current_step == 4:
    st.markdown('<div class="section-card">', unsafe_allow_html=True)
    st.markdown("### 4. Lock Quote")

    name = st.session_state.get("cust_name", "")
    phone = st.session_state.get("cust_phone", "")
    address = st.session_state.get("cust_address", "")

    if not (name and phone and address):
        st.warning("Please complete Customer details in Step 1")
    elif not st.session_state.cart:
        st.warning("Cart is empty")
    else:
        total = sum(i["line_total"] for i in st.session_state.cart)
        st.success(f"Ready for **{len(st.session_state.cart)}** device(s)")
        st.metric("Total Payout", f"{curr_sym}{total:,.0f}")

        if st.button("🔒 Lock Quote & Generate Voucher", type="primary", use_container_width=True):
