elif st.session_state.current_step == 4:
    st.markdown('<div class="section-card">', unsafe_allow_html=True)
    st.markdown("### 4. Lock Quote & Generate Voucher")

    customer_name = st.session_state.get("cust_name", "")
    customer_phone = st.session_state.get("cust_phone", "")
    customer_address = st.session_state.get("cust_address", "")

    details_ok = all([str(customer_name).strip(), str(customer_phone).strip(), str(customer_address).strip()])
    cart_ok = len(st.session_state.cart) > 0

    if not details_ok:
        st.warning("Customer details are missing. Please go back to Step 1.")
    if not cart_ok:
        st.warning("Cart is empty. Please add devices.")

    if details_ok and cart_ok:
        total_payout = sum(item["line_total"] for item in st.session_state.cart)
        st.success(f"Ready to lock quote for **{len(st.session_state.cart)} device(s)**")
        st.metric("Total Payout", f"{curr_sym}{total_payout:,.0f}")

        if st.button("🔒 Lock Quote & Generate Voucher", type="primary", use_container_width=True):
            quote_id = f"ER-{random.randint(100000, 999999)}"
            timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
            models_summary = ", ".join([f"{i['model']}×{i['qty']}" for i in st.session_state.cart])

            st.session_state.quote_history.append({
                "Quote ID": quote_id,
                "Timestamp": timestamp,
                "Customer": customer_name,
                "Phone": customer_phone,
                "Devices": models_summary,
                "Total Offer": f"{curr_sym}{total_payout:,.0f}",
                "Status": "Approved – Pending Inspection"
            })

