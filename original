            st.session_state.quote_history.append({
                "Quote ID": quote_id,
                "Timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
                "Customer": name,
                "Email": st.session_state.user_email,
                "Phone": phone,
                "Devices": models,
                "Total Offer": f"{curr_sym}{total:,.0f}",
                "Status": "Approved – Pending Inspection"
            })
            st.success(f"✅ Quote **{quote_id}** locked!\n\nTotal: **{curr_sym}{total:,.0f}**")
            st.balloons()
