if st.session_state.role == "customer":
    st.markdown(CUSTOMER_CSS, unsafe_allow_html=True)

    # ----- Customer Login -----
    if not st.session_state.logged_in:
        st.markdown("""
        <div class="eraise-header">
            <div class="eraise-logo">ERaise</div>
            <div style="color:#fce7f3;">Customer Portal</div>
        </div>
        """, unsafe_allow_html=True)

        st.markdown('<div class="section-card" style="max-width:500px; margin:40px auto;">', unsafe_allow_html=True)
        st.markdown("### 🔐 Customer Login / Sign In")
        email = st.text_input("Email Address", placeholder="you@example.com")
        name = st.text_input("Full Name", placeholder="Rahul Sharma")

        if st.button("Continue", type="primary", use_container_width=True):
            if email and "@" in email and name.strip():
                email = email.strip().lower()
                st.session_state.user_email = email
                st.session_state.user_name = name.strip()
                st.session_state.is_returning_user = email in st.session_state.known_customers
                st.session_state.known_customers.add(email)
                st.session_state.logged_in = True
                st.rerun()
            else:
                st.error("Please enter valid Name and Email")
        st.markdown('</div>', unsafe_allow_html=True)
        st.stop()

    # ----- Customer Main App -----
    now = datetime.datetime.now().strftime("%A, %d %B %Y • %I:%M %p IST")
    st.markdown(f"""
    <div class="eraise-header">
        <div>
            <div class="eraise-logo">ERaise</div>
            <div style="color:#fce7f3; font-size:1rem;">Customer Portal</div>
        </div>
        <div style="text-align:right; font-size:0.9rem;">
            👤 {st.session_state.user_name}<br>{st.session_state.user_email}<br>{now}
        </div>
    </div>
    """, unsafe_allow_html=True)

    if st.session_state.is_returning_user:
        st.success(f"👋 Welcome back, **{st.session_state.user_name}**!")
    else:
        st.info(f"🎉 Welcome **{st.session_state.user_name}**! First time with ERaise.")

    # Sidebar
    with st.sidebar:
        st.markdown("### 📱 Categories")
        for cat in DEVICE_CATALOG.keys():
            if st.button(cat, key=f"c_{cat}", use_container_width=True,
                         type="primary" if st.session_state.selected_category == cat else "secondary"):
                st.session_state.selected_category = cat
                st.session_state.current_step = 2
                st.rerun()

        st.markdown("---")
        selected_currency = st.selectbox("Currency", list(CURRENCIES.keys()))
        curr_sym = CURRENCIES[selected_currency]["symbol"]
        curr_rate = CURRENCIES[selected_currency]["rate"]

        st.markdown("---")
        if st.button("🚪 Logout", use_container_width=True):
            st.session_state.logged_in = False
            st.session_state.role = None
            st.rerun()

    # Steps
    steps = {1: "1. Customer", 2: "2. Add Devices", 3: "3. Cart", 4: "4. Lock Quote"}
    cols = st.columns(4)
    for i, (num, label) in enumerate(steps.items()):
        with cols[i]:
            if st.button(label, key=f"s_{num}", use_container_width=True,
                         type="primary" if st.session_state.current_step == num else "secondary"):
                st.session_state.current_step = num
                st.rerun()

    # STEP 1
    if st.session_state.current_step == 1:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("### 1. Customer & Pickup Details")
        c1, c2 = st.columns(2)
        with c1:
            st.text_input("Full Name *", value=st.session_state.user_name, key="cust_name")
            st.text_input("Email", value=st.session_state.user_email, key="cust_email")
        with c2:
            phone = st.text_input("Phone Number *", placeholder="+91 98765 43210", key="cust_phone")
            st.date_input("Preferred Pickup Date", key="cust_date")

        address = st.text_area("Pickup Address *", height=80, key="cust_address")

        if st.button("Next → Add Devices", type="primary", use_container_width=True):
            if st.session_state.get("cust_name") and st.session_state.get("cust_phone") and st.session_state.get("cust_address"):
                st.session_state.current_step = 2
                st.rerun()
            else:
                st.warning("Name, Phone Number and Address are mandatory")
        st.markdown('</div>', unsafe_allow_html=True)

    # STEP 2
    elif st.session_state.current_step == 2:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown(f"### 2. Add Device • {st.session_state.selected_category}")

        category = st.selectbox("Category", list(DEVICE_CATALOG.keys()),
                                index=list(DEVICE_CATALOG.keys()).index(st.session_state.selected_category))
        st.session_state.selected_category = category
        model = st.selectbox("Model", sorted(DEVICE_CATALOG[category].keys()))

        c1, c2, c3 = st.columns(3)
        with c1:
            storage = st.selectbox("Storage", list(STORAGE_PREMIUMS.keys()))
        with c2:
            condition = st.selectbox("Condition", list(CONDITION_MULTIPLIERS.keys()))
        with c3:
            carrier = st.selectbox("Network", list(CARRIER_MODIFIERS.keys()))

        imei = st.text_input("IMEI / Serial *")
        qty = st.number_input("Quantity", 1, 10, 1)

        base = DEVICE_CATALOG[category][model]
        raw = ((base + STORAGE_PREMIUMS[storage]) * CONDITION_MULTIPLIERS[condition]) + CARRIER_MODIFIERS[carrier]
        unit_price = max(8.0, raw) * curr_rate
        total_line = unit_price * qty

        st.info(f"Estimate: **{curr_sym}{total_line:,.0f}**")

        c1, c2 = st.columns(2)
        with c1:
            if st.button("➕ Add to Cart", type="secondary", use_container_width=True):
                if imei.strip():
                    st.session_state.cart.append({
                        "category": category, "model": model, "storage": storage,
                        "condition": condition, "carrier": carrier, "imei": imei,
                        "qty": qty, "unit_price": unit_price, "line_total": total_line
                    })
                    st.success("Added!")
                    st.rerun()
                else:
                    st.warning("Enter IMEI")
        with c2:
            if st.button("Next → Cart", type="primary", use_container_width=True):
                st.session_state.current_step = 3
                st.rerun()
        st.markdown('</div>', unsafe_allow_html=True)

    # STEP 3
    elif st.session_state.current_step == 3:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("### 3. Your Cart")
        if not st.session_state.cart:
            st.info("Cart empty")
        else:
            total = sum(i["line_total"] for i in st.session_state.cart)
            for idx, item in enumerate(st.session_state.cart):
                col1, col2 = st.columns([5,1])
                with col1:
                    st.markdown(f"""
                    <div class="device-card">
                        <b>{item['model']}</b> × {item['qty']}<br>
                        <small>{item['condition']} • {item['imei']}</small><br>
                        <span style="color:#047857; font-weight:800;">{curr_sym}{item['line_total']:,.0f}</span>
                    </div>
                    """, unsafe_allow_html=True)
                with col2:
                    if st.button("🗑️", key=f"d{idx}"):
                        st.session_state.cart.pop(idx)
                        st.rerun()
            st.markdown(f"### Total: **{curr_sym}{total:,.0f}**")
            if st.button("Next → Lock Quote", type="primary", use_container_width=True):
                st.session_state.current_step = 4
                st.rerun()
        st.markdown('</div>', unsafe_allow_html=True)

    # STEP 4
    elif st.session_state.current_step == 4:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("### 4. Lock Quote")
        if st.session_state.cart and st.session_state.get("cust_phone"):
            total = sum(i["line_total"] for i in st.session_state.cart)
            st.metric("Total Payout", f"{curr_sym}{total:,.0f}")

            if st.button("🔒 Lock Quote & Request Pickup", type="primary", use_container_width=True):
                quote_id = f"ER-{random.randint(100000,999999)}"
                order = {
                    "Quote ID": quote_id,
                    "Timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
                    "Customer Name": st.session_state.get("cust_name", st.session_state.user_name),
                    "Phone": st.session_state.get("cust_phone"),
                    "Email": st.session_state.user_email,
                    "Address": st.session_state.get("cust_address", ""),
                    "Devices": ", ".join([f"{i['model']}×{i['qty']}" for i in st.session_state.cart]),
                    "Items Detail": st.session_state.cart.copy(),
                    "Total Offer": f"{curr_sym}{total:,.0f}",
                    "Status": "Pending Pickup",
                    "Physical Verified": False,
                    "Verified By": "",
                    "Payment Done": False
                }
                st.session_state.quote_history.append(order)
                st.session_state.cart = []
                st.success(f"✅ Quote **{quote_id}** locked! Delivery partner will contact you soon.")
                st.balloons()
        else:
            st.warning("Complete previous steps and add phone number")
        st.markdown('</div>', unsafe_allow_html=True)

    # Customer Order Status
    my_orders = [o for o in st.session_state.quote_history if o.get("Email") == st.session_state.user_email]
    if my_orders:
        st.markdown('<div class="section-card">', unsafe_allow_html=True)
        st.markdown("### 📦 Your Orders Status")
        for o in my_orders:
            status_color = "🟢" if o["Physical Verified"] else "🟡"
            st.markdown(f"""
            **{o['Quote ID']}** {status_color} {o['Status']}  
            Devices: {o['Devices']} • Amount: {o['Total Offer']}  
            Phone: {o['Phone']}
            """)
            if o["Physical Verified"] and not o["Payment Done"]:
                st.success("Physical verification done! Delivery partner will hand over the money.")
        st.markdown('</div>', unsafe_allow_html=True)

# ════════════════════════════════════════════════
