        if st.button("← Back to Add Devices"):
            st.session_state.current_step = 2
            st.rerun()
    else:
        total_payout = 0
        for idx, item in enumerate(st.session_state.cart):
            total_payout += item["line_total"]
            col_a, col_b = st.columns([5, 1])
            with col_a:
                st.markdown(f"""
