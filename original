# ════════════════════════════════════════════════
elif st.session_state.role == "delivery":
    st.markdown(DELIVERY_CSS, unsafe_allow_html=True)

    # Delivery Login
    if not st.session_state.delivery_logged_in:
        st.markdown("""
        <div class="delivery-header">
            <div style="font-size:2rem; font-weight:900;">ERaise Delivery</div>
            <div>Partner Portal</div>
        </div>
        """, unsafe_allow_html=True)

        st.markdown('<div class="section-card" style="max-width:480px; margin:50px auto;">', unsafe_allow_html=True)
        st.markdown("### 🚚 Delivery Partner Login")
        d_name = st.text_input("Your Full Name", placeholder="Amit Kumar")
        d_id = st.text_input("Partner ID / Phone", placeholder="DEL-1001 or phone number")

        if st.button("Login as Delivery Partner", type="primary", use_container_width=True):
            if d_name.strip() and d_id.strip():
                st.session_state.delivery_name = d_name.strip()
                st.session_state.delivery_logged_in = True
                st.rerun()
            else:
                st.error("Enter Name and ID")
        st.markdown('</div>', unsafe_allow_html=True)
        st.stop()

    # Delivery Dashboard
    st.markdown(f"""
    <div class="delivery-header">
        <div>
            <div style="font-size:1.8rem; font-weight:900;">ERaise Delivery</div>
            <div>Partner Dashboard</div>
        </div>
        <div style="text-align:right;">
            🚚 {st.session_state.delivery_name}
        </div>
    </div>
    """, unsafe_allow_html=True)

    with st.sidebar:
        st.markdown(f"### Hello, {st.session_state.delivery_name}")
        st.markdown("---")
        if st.button("🔄 Refresh Orders", use_container_width=True):
            st.rerun()
        if st.button("🚪 Logout", use_container_width=True):
            st.session_state.delivery_logged_in = False
            st.session_state.role = None
            st.rerun()

    st.markdown("### 📋 Pending Pickups & Customers")

    pending = [o for o in st.session_state.quote_history if o["Status"] == "Pending Pickup"]
    verified = [o for o in st.session_state.quote_history if o["Physical Verified"] and not o["Payment Done"]]

    tab1, tab2, tab3 = st.tabs(["🟡 Pending Pickup", "✅ Verified (Pay Customer)", "👥 All Customers"])

    with tab1:
        if not pending:
            st.info("No pending pickups right now.")
        for order in pending:
            with st.container():
                st.markdown(f"""
                <div class="order-card">
                    <b>{order['Quote ID']}</b> • {order['Timestamp']}<br>
                    👤 <b>{order['Customer Name']}</b> &nbsp; 📞 <b>{order['Phone']}</b><br>
                    📍 {order['Address']}<br>
                    📦 {order['Devices']}<br>
                    💰 {order['Total Offer']}
                </div>
                """, unsafe_allow_html=True)

                st.markdown("**Physical Condition Check**")
                new_condition = st.selectbox(
                    "Actual Condition Found",
                    list(CONDITION_MULTIPLIERS.keys()),
                    key=f"cond_{order['Quote ID']}"
                )
                notes = st.text_area("Verification Notes", key=f"notes_{order['Quote ID']}", height=70)

                if st.button("✅ Successfully Checked – Physical Verification Done",
                             key=f"verify_{order['Quote ID']}", type="primary"):
                    # Update order
                    for o in st.session_state.quote_history:
                        if o["Quote ID"] == order["Quote ID"]:
                            o["Status"] = "Physical Verified – Ready for Payment"
                            o["Physical Verified"] = True
                            o["Verified By"] = st.session_state.delivery_name
                            o["Verification Notes"] = notes
                            o["Actual Condition"] = new_condition
                            break
                    st.success(f"Order {order['Quote ID']} marked as Physically Verified!")
                    st.balloons()
                    st.rerun()
                st.markdown("---")

    with tab2:
        if not verified:
            st.info("No orders waiting for payment.")
        for order in verified:
            st.markdown(f"""
            <div class="order-card">
                <b>{order['Quote ID']}</b><br>
                👤 {order['Customer Name']} • 📞 {order['Phone']}<br>
                💰 Pay: <b>{order['Total Offer']}</b><br>
                Verified by: {order.get('Verified By')}
            </div>
            """, unsafe_allow_html=True)
            if st.button(f"💵 Mark Payment Completed – {order['Quote ID']}", key=f"pay_{order['Quote ID']}"):
                for o in st.session_state.quote_history:
                    if o["Quote ID"] == order["Quote ID"]:
                        o["Status"] = "Payment Completed"
                        o["Payment Done"] = True
                        break
                st.success("Payment marked as completed!")
                st.rerun()

    with tab3:
        st.markdown("### Registered Customers")
        if not st.session_state.quote_history:
            st.info("No customers yet.")
        else:
            customers = {}
            for o in st.session_state.quote_history:
                phone = o.get("Phone", "")
                if phone not in customers:
                    customers[phone] = {
                        "Name": o.get("Customer Name"),
                        "Phone": phone,
                        "Email": o.get("Email"),
                        "Orders": 0
                    }
                customers[phone]["Orders"] += 1

            df = pd.DataFrame(customers.values())
            st.dataframe(df, use_container_width=True, hide_index=True)
